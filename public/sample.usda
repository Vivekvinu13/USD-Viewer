#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "Ground"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-3, 0, 3), (3, 0, 3), (3, 0, -3), (-3, 0, -3)]
        color3f[] primvars:displayColor = [(0.75, 0.78, 0.8)]
    }

    def Mesh "Crate"
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0,3,2,1, 4,5,6,7, 0,1,5,4, 1,2,6,5, 2,3,7,6, 3,0,4,7]
        point3f[] points = [(-2.1,0,0.6), (-0.9,0,0.6), (-0.9,0,-0.6), (-2.1,0,-0.6),
                            (-2.1,1.2,0.6), (-0.9,1.2,0.6), (-0.9,1.2,-0.6), (-2.1,1.2,-0.6)]
        color3f[] primvars:displayColor = [(0.85, 0.5, 0.2)]
