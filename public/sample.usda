    def Mesh "Pyramid"
    {
        int[] faceVertexCounts = [4, 3, 3, 3, 3]
        int[] faceVertexIndices = [0,3,2,1, 0,1,4, 1,2,4, 2,3,4, 3,0,4]
        point3f[] points = [(0.6,0,0.8), (2.2,0,0.8), (2.2,0,-0.8), (0.6,0,-0.8), (1.4,1.6,0)]
        color3f[] primvars:displayColor = [(0.2, 0.6, 0.9)]
    }
}
